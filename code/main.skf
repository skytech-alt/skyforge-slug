// skyforge-slug

функция транслит(символ) {
    если символ == "а" { вернуть "a" }
    если символ == "б" { вернуть "b" }
    если символ == "в" { вернуть "v" }
    если символ == "г" { вернуть "g" }
    если символ == "д" { вернуть "d" }
    если символ == "е" { вернуть "e" }
    если символ == "ё" { вернуть "yo" }
    если символ == "ж" { вернуть "zh" }
    если символ == "з" { вернуть "z" }
    если символ == "и" { вернуть "i" }
    если символ == "й" { вернуть "j" }
    если символ == "к" { вернуть "k" }
    если символ == "л" { вернуть "l" }
    если символ == "м" { вернуть "m" }
    если символ == "н" { вернуть "n" }
    если символ == "о" { вернуть "o" }
    если символ == "п" { вернуть "p" }
    если символ == "р" { вернуть "r" }
    если символ == "с" { вернуть "s" }
    если символ == "т" { вернуть "t" }
    если символ == "у" { вернуть "u" }
    если символ == "ф" { вернуть "f" }
    если символ == "х" { вернуть "kh" }
    если символ == "ц" { вернуть "ts" }
    если символ == "ч" { вернуть "ch" }
    если символ == "ш" { вернуть "sh" }
    если символ == "щ" { вернуть "shch" }
    если символ == "ъ" { вернуть "" }
    если символ == "ы" { вернуть "y" }
    если символ == "ь" { вернуть "" }
    если символ == "э" { вернуть "e" }
    если символ == "ю" { вернуть "yu" }
    если символ == "я" { вернуть "ya" }
    
    если символ == "А" { вернуть "A" }
    если символ == "Б" { вернуть "B" }
    если символ == "В" { вернуть "V" }
    если символ == "Г" { вернуть "G" }
    если символ == "Д" { вернуть "D" }
    если символ == "Е" { вернуть "E" }
    если символ == "Ё" { вернуть "Yo" }
    если символ == "Ж" { вернуть "Zh" }
    если символ == "З" { вернуть "Z" }
    если символ == "И" { вернуть "I" }
    если символ == "Й" { вернуть "J" }
    если символ == "К" { вернуть "K" }
    если символ == "Л" { вернуть "L" }
    если символ == "М" { вернуть "M" }
    если символ == "Н" { вернуть "N" }
    если символ == "О" { вернуть "O" }
    если символ == "П" { вернуть "P" }
    если символ == "Р" { вернуть "R" }
    если символ == "С" { вернуть "S" }
    если символ == "Т" { вернуть "T" }
    если символ == "У" { вернуть "U" }
    если символ == "Ф" { вернуть "F" }
    если символ == "Х" { вернуть "Kh" }
    если символ == "Ц" { вернуть "Ts" }
    если символ == "Ч" { вернуть "Ch" }
    если символ == "Ш" { вернуть "Sh" }
    если символ == "Щ" { вернуть "Shch" }
    если символ == "Ъ" { вернуть "" }
    если символ == "Ы" { вернуть "Y" }
    если символ == "Ь" { вернуть "" }
    если символ == "Э" { вернуть "E" }
    если символ == "Ю" { вернуть "Yu" }
    если символ == "Я" { вернуть "Ya" }
    
    вернуть символ
}

функция это_буква_или_цифра(символ) {
    пусть к = код_символа(символ)
    // A-Z
    если к >= 65 и к <= 90 { вернуть истина }
    // a-z
    если к >= 97 и к <= 122 { вернуть истина }
    // 0-9
    если к >= 48 и к <= 57 { вернуть истина }
    вернуть ложь
}

функция slugify(текст) {
    пусть рез = ""
    пусть предыдущий_дефис = ложь
    
    для с в строка_символы(текст) {
        пусть т = транслит(с)
        
        // Обрабатываем каждый символ результата транслитерации
        для тс в строка_символы(т) {
            если это_буква_или_цифра(тс) {
                рез = рез + нижний_регистр(тс)
                предыдущий_дефис = ложь
            } иначе {
                если не предыдущий_дефис и длина(рез) > 0 {
                    рез = рез + "-"
                    предыдущий_дефис = истина
                }
            }
        }
    }
    
    // Удаляем дефис с конца
    если длина(рез) > 0 и рез[длина(рез)-1] == "-" {
        рез = подстрока(рез, 0, длина(рез)-1)
    }
    
    вернуть рез
}
